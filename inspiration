    <style>
        @layer base {

            html,
            body {
                margin: 0;
                padding: 0;
                background-color: #FDFBF7;
            }

            body {
                overscroll-behavior: none;
            }

            main> :first-child {
                margin-top: 0 !important;
            }

            main> :last-child {
                margin-bottom: 0 !important;
            }
        }

        ::-webkit-scrollbar {
            display: none;
        }

        .paper-texture {
            background-image: url("https://www.transparenttextures.com/patterns/p6.png");
        }

        .wood-stroke {
            border: 1px solid #D4B28C;
            box-shadow: inset 0 0 4px rgba(212, 178, 140, 0.2);
        }

        .cyan-glow {
            box-shadow: 0 0 20px rgba(0, 168, 204, 0.15);
        }

        .espresso-finish {
            background: linear-gradient(rgba(42, 24, 1, 0.95), rgba(42, 24, 1, 0.95)), url("https://www.transparenttextures.com/patterns/wood-pattern.png");
            background-color: #2A1801;
        }

        .marquee-container {
            display: flex;
            overflow: hidden;
            user-select: none;
            gap: 2rem;
        }

        .marquee-content {
            flex-shrink: 0;
            display: flex;
            justify-content: space-around;
            min-width: 100%;
            gap: 2rem;
            animation: scroll 40s linear infinite;
        }

        @keyframes scroll {
            from {
                transform: translateX(0);
            }

            to {
                transform: translateX(calc(-100% - 2rem));
            }
        }

        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, #c6c7c0 50%, transparent);
            opacity: 0.3;
        }
    </style>
